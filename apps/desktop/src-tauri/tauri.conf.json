{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "Solo",
  "version": "0.2.0-beta.1",
  "identifier": "com.solo.ide",
  "build": {
    "beforeDevCommand": "bun run dev:vite",
    "devUrl": "http://localhost:5173",
    "beforeBuildCommand": "bun run build:vite",
    "frontendDist": "../dist"
  },
  "app": {
    "withGlobalTauri": true,
    "macOSPrivateApi": true,
    "windows": [
      {
        "title": "Solo",
        "width": 1400,
        "height": 900,
        "minWidth": 800,
        "minHeight": 600,
        "resizable": true,
        "fullscreen": false,
        "decorations": true,
        "transparent": true,
        "titleBarStyle": "Overlay",
        "hiddenTitle": true,
        "trafficLightPosition": { "x": 13, "y": 13 }
      },
      {
        "label": "voice-hud",
        "url": "hud.html",
        "title": "Solo Voice HUD",
        "width": 220,
        "height": 48,
        "resizable": false,
        "decorations": false,
        "transparent": true,
        "alwaysOnTop": true,
        "skipTaskbar": true,
        "focus": false,
        "visible": false
      }
    ],
    "security": {
      "csp": null
    }
  },
  "bundle": {
    "active": true,
    "targets": "all",
    "createUpdaterArtifacts": true,
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.ico",
      "icons/icon.png"
    ],
    "macOS": {
      "minimumSystemVersion": "10.15",
      "entitlements": "./Entitlements.plist",
      "signingIdentity": null
    }
  },
  "plugins": {
    "shell": {
      "open": true
    },
    "deep-link": {
      "desktop": {
        "schemes": [
          "soloide"
        ]
      }
    },
    "updater": {
      "pubkey": "dW50cnVzdGVkIGNvbW1lbnQ6IG1pbmlzaWduIHB1YmxpYyBrZXk6IDI0NjIyNTEyQjJGRDk1RDkKUldUWmxmMnlFaVZpSk1VK3ZtRVhPbnd2UVR6MGpRUWdUcC8xZ1MxU013ZVdzeFowVzdUTmQ2MUMK",
      "endpoints": [
        "https://github.com/Solo-UDE/solo-releases/releases/latest/download/latest.json"
      ]
    }
  }
}
