{
  "name": "solo-ide",
  "private": true,
  "workspaces": [
    "apps/desktop",
    "packages/*",
    "agent-bridge",
    "infra"
  ],
  "scripts": {
    "postinstall": "bun run --filter @solo/agent-bridge build",
    "dev": "bun run --filter @solo/agent-bridge --filter @solo/desktop dev",
    "dev:auth": "bun scripts/dev-auth.mjs",
    "dev:auth:mac": "bun scripts/dev-auth-mac.mjs",
    "dev:auth:mac:restore": "bun scripts/dev-auth-mac-restore.mjs",
    "auth:doctor": "bun scripts/auth-doctor.mjs",
    "auth:diagnose": "bun scripts/auth-diagnose.mjs",
    "bridge:build": "bun run --filter @solo/agent-bridge build",
    "bridge:compile:mac": "mkdir -p apps/desktop/src-tauri/binaries && bun build --compile --target=bun-darwin-arm64 --outfile apps/desktop/src-tauri/binaries/agent-bridge-aarch64-apple-darwin agent-bridge/src/index.ts",
    "bridge:dev": "bun run --filter @solo/agent-bridge dev",
    "build": "bun run --filter @solo/agent-bridge build && bun run --filter @solo/desktop build:vite && cargo build --release",
    "tauri": "bun run --filter @solo/desktop tauri",
    "check": "cargo check && bun run --filter '*' typecheck",
    "test": "cargo test && node scripts/run-workspace-tests.mjs",
    "test:desktop-auth": "bun run gen:bindings && bun run --filter @solo/desktop build:vite && cargo test -p solo-desktop desktop_config::tests -- --nocapture && cargo test -p solo-desktop auth_commands::tests -- --nocapture",
    "premerge:master": "bash scripts/premerge-master.sh",
    "release:master": "node scripts/release-master.mjs",
    "extract:codex": "bun scripts/codex-extract/launch.ts",
    "extract:codex:dry": "bun scripts/codex-extract/launch.ts --dry-run",
    "extract:codex:post": "bun scripts/codex-extract/post-process.ts",
    "clean": "cargo clean && rm -rf node_modules apps/*/node_modules packages/*/node_modules agent-bridge/node_modules agent-bridge/dist",
    "gen:bindings": "cargo test -p solo-protocol -p solo-auth && mkdir -p apps/desktop/src/bindings && cp -r crates/solo-protocol/apps/desktop/src/bindings/* apps/desktop/src/bindings/ && cp -r crates/solo-auth/apps/desktop/src/bindings/* apps/desktop/src/bindings/ && rm -rf crates/solo-protocol/apps crates/solo-auth/apps && node scripts/gen-barrel.mjs",
    "version:bump": "node scripts/bump-version.mjs"
  },
  "devDependencies": {
    "@types/bun": "^1.1.14",
    "typescript": "^5.7.3"
  },
  "engines": {
    "node": ">=20"
  },
  "packageManager": "bun@1.1.42",
  "overrides": {
    "@tiptap/core": "3.22.3",
    "@tiptap/pm": "3.22.3",
    "@tiptap/react": "3.22.3",
    "@tiptap/starter-kit": "3.22.3",
    "@tiptap/extension-image": "3.22.3",
    "@tiptap/extension-link": "3.22.3",
    "@tiptap/extension-placeholder": "3.22.3",
    "@tiptap/extension-table": "3.22.3",
    "@tiptap/extension-table-cell": "3.22.3",
    "@tiptap/extension-table-header": "3.22.3",
    "@tiptap/extension-table-row": "3.22.3",
    "@tiptap/extension-task-item": "3.22.3",
    "@tiptap/extension-task-list": "3.22.3",
    "@tiptap/extension-typography": "3.22.3",
    "@tiptap/markdown": "3.22.3"
  },
  "dependencies": {
    "@radix-ui/react-icons": "1.3.2",
    "@radix-ui/react-slot": "1.2.4",
    "@tiptap/extension-image": "3.22.3",
    "@tiptap/extension-link": "3.22.3",
    "@tiptap/extension-placeholder": "3.22.3",
    "@tiptap/extension-table": "3.22.3",
    "@tiptap/extension-table-cell": "3.22.3",
    "@tiptap/extension-table-header": "3.22.3",
    "@tiptap/extension-table-row": "3.22.3",
    "@tiptap/extension-task-item": "3.22.3",
    "@tiptap/extension-task-list": "3.22.3",
    "@tiptap/extension-typography": "3.22.3",
    "@tiptap/markdown": "3.22.3",
    "@tiptap/pm": "3.22.3",
    "@tiptap/react": "3.22.3",
    "@tiptap/starter-kit": "3.22.3",
    "lucide-react": "1.8.0",
    "remark-gfm": "4.0.1"
  }
}
