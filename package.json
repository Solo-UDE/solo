{
  "name": "solo-ide",
  "private": true,
  "workspaces": [
    "apps/desktop",
    "packages/*"
  ],
  "scripts": {
    "dev": "bun run --filter @solo/desktop dev",
    "build": "cargo build --release && bun run --filter @solo/desktop build",
    "tauri": "bun run --filter @solo/desktop tauri",
    "check": "cargo check && bun run --filter '*' typecheck",
    "test": "cargo test && bun run --filter '*' test",
    "clean": "cargo clean && rm -rf node_modules apps/*/node_modules packages/*/node_modules",
    "gen:bindings": "cargo test -p solo-protocol && cp -r target/bindings apps/desktop/src/"
  },
  "devDependencies": {
    "@types/bun": "^1.1.14",
    "typescript": "^5.7.3"
  },
  "engines": {
    "node": ">=20"
  },
  "packageManager": "bun@1.1.42"
}
