{
  "name": "@solo/agent-bridge",
  "version": "0.1.0",
  "description": "Claude Agent SDK bridge for Orbit Editor",
  "type": "module",
  "main": "dist/index.js",
  "scripts": {
    "build": "tsup src/index.ts --format esm --target node18 --external bun:sqlite --clean --sourcemap",
    "build:bundle": "tsup src/index.ts --format esm --target node18 --external bun:sqlite --clean --minify --no-splitting",
    "dev": "tsup src/index.ts --format esm --target node18 --external bun:sqlite --watch",
    "typecheck": "tsc --noEmit",
    "start": "node dist/index.js"
  },
  "dependencies": {
    "@anthropic-ai/claude-agent-sdk": "^0.1.76",
    "@anthropic-ai/sdk": "^0.39.0",
    "@modelcontextprotocol/sdk": "^1.0.0",
    "better-sqlite3": "^12.9.0"
  },
  "devDependencies": {
    "@types/better-sqlite3": "^7.6.13",
    "@types/node": "^20.17.0",
    "tsup": "^8.3.5",
    "typescript": "^5.7.2"
  },
  "engines": {
    "node": ">=18.0.0"
  }
}
