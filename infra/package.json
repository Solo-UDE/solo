{
  "name": "@solo/infra",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "description": "AWS CDK infrastructure for Solo IDE — Cognito auth, stats API, leaderboard",
  "bin": {
    "solo-infra": "bin/solo.ts"
  },
  "scripts": {
    "build": "tsc",
    "watch": "tsc -w",
    "synth": "cdk synth",
    "synth:dev": "cdk synth --context stage=dev",
    "synth:prod": "cdk synth --context stage=prod",
    "diff:dev": "cdk diff --context stage=dev --profile solo",
    "diff:prod": "cdk diff --context stage=prod --profile solo",
    "deploy:dev": "cdk deploy --all --context stage=dev --profile solo --require-approval never && bun run sync-env:dev",
    "deploy:prod": "cdk deploy --all --context stage=prod --profile solo --require-approval any-change && bun run sync-env:prod",
    "sync-env:dev": "bun scripts/sync-env.mjs dev",
    "sync-env:prod": "bun scripts/sync-env.mjs prod",
    "destroy:dev": "cdk destroy --all --context stage=dev --profile solo",
    "bootstrap:dev": "cdk bootstrap --context stage=dev --profile solo",
    "typecheck": "tsc --noEmit"
  },
  "devDependencies": {
    "@types/aws-lambda": "^8.10.152",
    "@types/node": "^22.10.0",
    "aws-cdk": "^2.170.0",
    "esbuild": "^0.24.0",
    "typescript": "^5.7.3"
  },
  "dependencies": {
    "@aws-sdk/client-cognito-identity-provider": "^3.699.0",
    "@aws-sdk/client-dynamodb": "^3.699.0",
    "@aws-sdk/client-kms": "^3.699.0",
    "@aws-sdk/client-s3": "^3.699.0",
    "@aws-sdk/client-secrets-manager": "^3.699.0",
    "@aws-sdk/lib-dynamodb": "^3.699.0",
    "@aws-sdk/s3-request-presigner": "^3.699.0",
    "@resvg/resvg-wasm": "^2.6.0",
    "aws-cdk-lib": "^2.170.0",
    "constructs": "^10.4.2",
    "satori": "^0.12.0",
    "source-map-support": "^0.5.21"
  }
}
